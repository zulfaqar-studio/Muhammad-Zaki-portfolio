# Local server
PORT=8787
HOST=127.0.0.1
ADMIN_TOKEN=

# Local-only AI credentials
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Vercel public API configuration
# These are Vercel-side values; do not put secrets in VITE_* variables.
PUBLIC_API_ORIGINS=https://zulfaqar-studio.github.io,http://localhost:5173

VITE_API_BASE_URL=https://zaki-portfolio-rouge.vercel.app

# Server-side public Google Drive fallback used only by Vercel /api/media.
GOOGLE_DRIVE_PUBLIC_MEDIA_FOLDER_ID=
GOOGLE_DRIVE_PUBLIC_CERT_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_CLIENT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
