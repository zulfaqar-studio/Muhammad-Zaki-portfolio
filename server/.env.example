# Local control-plane configuration
PORT=8787
HOST=127.0.0.1

# Optional: require this token for admin/content mutations.
# Keep it local; never put it in VITE_* variables.
ADMIN_TOKEN=

# DeepSeek is used only by the local server.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

PORTFOLIO_DATA_PATH=client/public/data/portfolio.json
DEEPSEEK_DATA_PATH=client/public/data/deepseek.json

# Comma-separated extra local origins, when needed.
CORS_ORIGINS=
