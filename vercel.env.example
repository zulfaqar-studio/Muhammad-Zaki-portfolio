# Vercel / Redis public API configuration
# Required for Redis-backed content:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional Redis keys
REDIS_PORTFOLIO_KEY=zaki:portfolio:v1
REDIS_KNOWLEDGE_KEY=zaki:knowledge:v1

# Protect PUT /api/content
API_ADMIN_TOKEN=

# Optional live AI endpoint
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Comma-separated allowed browser origins.
# Include the public GitHub Pages origin and your local Vite origin.
PUBLIC_API_ORIGINS=https://zulfaqar-studio.github.io,http://localhost:5173

# Local API URL used by the client build.
VITE_API_BASE_URL=https://zaki-portfolio-rouge.vercel.app
